{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "%LOCALAPPDATA%\\fastfetch\\logo.txt",
        "color": { "1": "38;2;156;207;216" },
        "padding": { "top": 0, "right": 2 }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "38;2;156;207;216" }
    },
    "modules": [
        { "type": "custom", "format": "┌──────────────────────────────────────────────┐" },
        { "type": "os", "key": "  OS:", "format": "\u001b[38;2;156;207;216mWindows 11 Pro" },
        { "type": "host", "key": " 󰌢 Host:", "format": "\u001b[38;2;180;156;222mNitro AN515-57" },
        { "type": "localip", "key": " 󰈀 Local IP:", "format": "\u001b[38;2;236;99;140m{1}" },
        { "type": "custom", "format": "└──────────────────────────────────────────────┘" },
        { "type": "custom", "key": "  User:", "format": "\u001b[38;2;255;255;255mroot@mykey (WSL Nix)" },
        { "type": "custom", "key": "  GitLab:", "format": "\u001b[38;2;56;140;156m@mykeyy" },
        { "type": "custom", "key": "  GitHub:", "format": "\u001b[38;2;56;140;156m@mykeyy" },
        { "type": "custom", "format": "┌──────────────────────────────────────────────┐" },
        { "type": "cpu", "key": "  CPU:", "format": "\u001b[38;2;180;156;222m{1}" },
        { "type": "custom", "key": "  GPU (NVIDIA):", "format": "\u001b[38;2;180;156;222mGeForce RTX 3050 Ti (Laptop)" },
        { "type": "memory", "key": "  Memory:", "format": "\u001b[38;2;255;202;120m{1} / {2} (\u001b[38;2;255;250;194m{3}\u001b[38;2;255;202;120m)" },
        { "type": "disk", "key": " 󰋊 Disk C:", "folders": "C:\\", "format": "\u001b[38;2;255;202;120m{1} / {2} (\u001b[38;2;255;250;194m{3}\u001b[38;2;255;202;120m)" },
        { "type": "disk", "key": " 󰋊 Disk D:", "folders": "D:\\", "format": "\u001b[38;2;255;202;120m{1} / {2} (\u001b[38;2;255;250;194m{3}\u001b[38;2;255;202;120m)" },
        { "type": "custom", "format": "└──────────────────────────────────────────────┘" },
        "break",
        { "type": "colors", "symbol": "circle" }
    ]
}
