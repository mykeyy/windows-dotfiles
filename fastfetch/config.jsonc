{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    // Replace logo.txt with your own ASCII/text logo whenever you want.
    "logo": {
        "type": "file",
        "source": "%LOCALAPPDATA%\\fastfetch\\logo.txt",
        "color": { "1": "38;2;156;207;216" },
        "padding": { "top": 0, "right": 2 }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "38;2;156;207;216" }
    },
    "modules": [
        { "type": "custom", "format": "┌──────────────────────────────────────────────┐" },

        // These read from the current PC: no Acer-specific names are baked in.
        { "type": "os", "key": "  OS:" },
        { "type": "host", "key": " 󰌢 Host:" },
        { "type": "localip", "key": " 󰈀 Local IP:", "format": "\u001b[38;2;236;99;140m{1}" },
        { "type": "custom", "format": "└──────────────────────────────────────────────┘" },

        // Optional personal lines live in fastfetch/README.md.
        { "type": "custom", "format": "┌──────────────────────────────────────────────┐" },
        { "type": "cpu", "key": "  CPU:", "format": "\u001b[38;2;180;156;222m{1}" },
        { "type": "gpu", "key": "  GPU:" },
        { "type": "memory", "key": "  Memory:", "format": "\u001b[38;2;255;202;120m{1} / {2} (\u001b[38;2;255;250;194m{3}\u001b[38;2;255;202;120m)" },
        { "type": "disk", "key": " 󰋊 System disk:", "folders": "C:\\", "format": "\u001b[38;2;255;202;120m{1} / {2} (\u001b[38;2;255;250;194m{3}\u001b[38;2;255;202;120m)" },
        { "type": "custom", "format": "└──────────────────────────────────────────────┘" },
        "break",
        { "type": "colors", "symbol": "circle" }
    ]
}
